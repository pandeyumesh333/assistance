{
  "expo": {
    "name": "life-assistant",
    "slug": "life-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "This app uses your motion data to track your steps and activity.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice-to-text task creation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.umesh8943123.lifeassistant",
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "ACTIVITY_RECOGNITION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-location",
      "expo-sensors",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F46E5",
          "sounds": [
            "./assets/sounds/alarm.mp3"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useAndroidX": true,
            "enableJetifier": true,
            "extraProguardRules": "-keep class com.react.** { *; }\n-keep class com.wenkesj.voice.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.google.android.gms.internal.** { *; }\n-keep class expo.modules.notifications.** { *; }\n-keep class expo.modules.av.** { *; }"
          }
        }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow Life Assistant to access the microphone for voice-to-text tasks."
        }
      ],
      "./plugins/withAndroidXResolution",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "604872ce-d191-4b01-93bf-9fe17a472e1c"
      }
    }
  }
}
